{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Emacs launch.json",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "default": "0.2.0"
    },
    "configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "request": {
            "type": "string",
            "enum": [
              "launch",
              "attach"
            ]
          },
          "dap-compilation": {
            "type": "string",
            "description": "Command to run before starting the debug session."
          },
          "dap-compilation-dir": {
            "type": "string",
            "description": "Working directory for the compilation command."
          }
        },
        "required": [
          "name",
          "type",
          "request"
        ],
        "allOf": [
          {
            "title": "stlinkgdbtarget — test-adapter 1.4.0",
            "$comment": "Generated from STMicroelectronics.test-adapter@1.4.0",
            "if": {
              "properties": {
                "type": {
                  "const": "stlinkgdbtarget"
                },
                "request": {
                  "const": "launch"
                }
              },
              "required": [
                "type",
                "request"
              ]
            },
            "then": {
              "required": [
                "program",
                "name"
              ],
              "x-future-keyword": {
                "minimum": 9007199254740993
              },
              "properties": {
                "request": {
                  "const": "launch"
                },
                "program": {
                  "type": "string",
                  "description": "Executable"
                },
                "enabled": {
                  "default": false
                },
                "commands": {
                  "default": []
                },
                "optional": {
                  "default": null
                },
                "mode": {
                  "enum": [
                    "auto"
                  ],
                  "default": "auto"
                }
              }
            }
          },
          {
            "title": "stlinkgdbtarget — test-adapter 1.4.0",
            "$comment": "Generated from STMicroelectronics.test-adapter@1.4.0",
            "if": {
              "properties": {
                "type": {
                  "const": "stlinkgdbtarget"
                },
                "request": {
                  "const": "attach"
                }
              },
              "required": [
                "type",
                "request"
              ]
            },
            "then": {
              "properties": {
                "request": {
                  "const": "attach"
                }
              }
            }
          }
        ]
      }
    }
  }
}
